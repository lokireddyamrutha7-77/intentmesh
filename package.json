{
  "name": "intentmesh",
  "version": "0.1.0",
  "private": true,
  "description": "Modular, security-conscious cross-chain intent execution marketplace",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "tsc --build --force packages/protocol-types packages/intent-schema packages/solver-sdk packages/risk-engine packages/chain-adapters packages/verification-sdk services/execution-monitor services/failure-manager services/indexer apps/api apps/web solvers",
    "test": "node tests/e2e/run_e2e_mvp_test.js",
    "demo": "node tests/e2e/run_e2e_mvp_test.js",
    "demo:failure": "node tests/e2e/run_e2e_mvp_test.js",
    "dev:web": "pnpm --filter @intentmesh/web dev",
    "start:api": "pnpm --filter @intentmesh/api start",
    "anvil:source": "anvil --port 8545 --chain-id 31337",
    "anvil:destination": "anvil --port 8546 --chain-id 31338",
    "deploy:local": "powershell -ExecutionPolicy Bypass -File scripts/deploy-local.ps1",
    "test:phase7": "node tests/e2e/test_phase7_deployment.js",
    "test:phase8": "node tests/e2e/test_phase8_api.js",
    "test:phase9": "node tests/e2e/test_phase9_frontend_indexer.js",
    "test:final": "node tests/e2e/test_final_prototype.js",
    "test:solver-network": "node tests/e2e/test_solver_network.js",
    "test:real-runtime": "node tests/e2e/test_real_runtime.js",
    "test:real-destination": "node tests/e2e/test_real_destination_execution.js"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "typescript": "^5.7.3"
  }
}
