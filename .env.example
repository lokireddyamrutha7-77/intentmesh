# IntentMesh Protocol — Safe Environment Configuration Template
# COPY TO .env BEFORE RUNNING IN PRODUCTION MODE

NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Local EVM Simulation RPC URLs
SOURCE_CHAIN_RPC_URL=http://127.0.0.1:8545
DESTINATION_CHAIN_RPC_URL=http://127.0.0.1:8546

# Local Chain IDs
SOURCE_CHAIN_ID=31337
DESTINATION_CHAIN_ID=31338

# Local Development Signer Configuration (Anvil Account #1 default placeholder)
# NOTE: DO NOT COMMIT REAL PRIVATE KEYS. Provide your local Anvil private key in .env
SOLVER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# Contract Address Overrides (Populated after local deployment)
INTENT_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
INPUT_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
SOLVER_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
SOLVER_BOND_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000
CAPACITY_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
BATCH_AUCTION_ADDRESS=0x0000000000000000000000000000000000000000
VERIFICATION_ADAPTER_ADDRESS=0x0000000000000000000000000000000000000000
SETTLEMENT_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000
MOCK_USDC_ADDRESS=0x0000000000000000000000000000000000000000

# AI Advisory Badge Config
ENABLE_AI_ADVISORY=true
AI_ADVISORY_MODE=NON_AUTHORITATIVE
